rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isEmployee() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == "admin";
    }

    function isActive() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status != "deactivated" &&
        get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.status != "suspended";
    }

    // ── Customers ──────────────────────────────────────────────────
    match /customers/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── Transactions ───────────────────────────────────────────────
    match /transactions/{txId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000;

      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid || isEmployee());

      allow update: if isEmployee() && isActive()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["status", "verifiedBy", "verifiedAt", "submittedBy", "submittedAt"]);

      allow delete: if false;
    }

    // ── Employees ──────────────────────────────────────────────────
    match /employees/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Only admin can create/update employee documents
      allow create: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["fullName", "role", "status", "updatedAt", "updatedBy"]);
      allow delete: if false;
    }

    // ── Audit Logs ─────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow create: if isEmployee();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
